{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2021",
    "noImplicitAny": true,
    "moduleResolution": "Bundler",
    "importHelpers": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["DOM", "DOM.Iterable", "ES2021"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
