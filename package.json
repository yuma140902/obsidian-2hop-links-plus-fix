{
  "name": "2hop-links-plus-fix",
  "version": "0.38.0",
  "description": "Related links up to 2 hops away are displayed in a card format, allowing for easy browsing through connections between notes. Each card contains a preview of the corresponding note.",
  "main": "main.js",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "tsc -noEmit -skipLibCheck && biome check",
    "format": "biome format --write ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@babel/preset-react": "8.0.1",
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "builtin-modules": "5.3.0",
    "esbuild": "0.28.1",
    "obsidian": "1.13.1",
    "typescript": "5.9.3"
  }
}
